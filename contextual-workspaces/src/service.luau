local DATA_PATH = noctalia.pluginDataDir() .. "/contexts.json"

local function shellQuote(s)
    return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local function loadData()
    local raw = noctalia.readFile(DATA_PATH)
    if not raw then
        return { activeContext = nil, contexts = {} }
    end
    local ok, data = pcall(noctalia.json.decode, raw)
    if not ok or type(data) ~= "table" then
        return { activeContext = nil, contexts = {} }
    end
    data.contexts = data.contexts or {}
    return data
end

local function findContextById(data, id)
    for _, ctx in ipairs(data.contexts) do
        if ctx.id == id then
            return ctx
        end
    end
    return nil
end

local function regenerateHyprlandRules(contexts)
    local path = noctalia.expandPath(noctalia.getConfig("hyprland-rules-file") or "~/.config/hypr/contextual-workspaces.lua")
    local lines = {
        "-- AUTOGENERATED by the Contextual Workspaces plugin (rnguyen03/contextual-workspaces).",
        "-- Regenerated on every context save. Do not hand-edit -- edit contexts via the plugin panel.",
        "",
    }
    for _, ctx in ipairs(contexts) do
        for _, m in ipairs(ctx.members or {}) do
            if m.pin and m.class and m.class ~= "" and m.workspace then
                table.insert(lines, string.format(
                    'hl.window_rule({ name = %q, match = { class = %q }, workspace = %q })',
                    "cw-" .. ctx.id .. "-" .. (m.label or "app"):lower():gsub("[^%w]+", "-"),
                    m.class,
                    tostring(m.workspace) .. " silent"
                ))
            end
        end
    end

    noctalia.mkdirAll(noctalia.expandPath("~/.config/hypr"))
    local ok = noctalia.writeFile(path, table.concat(lines, "\n") .. "\n")
    if not ok then
        noctalia.notifyError("Contextual Workspaces", "Couldn't write " .. path)
        return
    end

    if noctalia.getConfig("auto-reload-hyprland") then
        noctalia.runAsync("hyprctl reload")
    end
end

local function saveData(data)
    data.contexts = data.contexts or {}
    local ok = noctalia.writeFile(DATA_PATH, noctalia.json.encode(data))
    if not ok then
        noctalia.notifyError("Contextual Workspaces", "Couldn't save contexts")
        return
    end
    regenerateHyprlandRules(data.contexts)
    noctalia.state.set("cw.data", data)
end

-- This Hyprland install routes dispatches through its Lua config (`hl.dsp.*`), not the
-- classic bracket-prefixed `hyprctl dispatch exec "[workspace N silent] cmd"` string --
-- that form is parsed as Lua and fails silently (window lands on the current workspace
-- instead of the target one). Confirmed empirically: `hyprctl dispatch
-- 'hl.dsp.exec_cmd("kitty", { workspace = "9 silent" })'` is the form that actually works.
local function dispatchExec(cmd, workspace)
    local rules = workspace and string.format(", { workspace = %q }", tostring(workspace) .. " silent") or ""
    local luaExpr = string.format("hl.dsp.exec_cmd(%q%s)", cmd, rules)
    noctalia.runAsync("hyprctl dispatch " .. shellQuote(luaExpr))
end

local function applyContextVisuals(ctx)
    if noctalia.getConfig("enable-wallpaper-switch") and ctx.wallpaper and ctx.wallpaper ~= "" then
        noctalia.setWallpaper(ctx.wallpaper)
    end
    if noctalia.getConfig("enable-theme-switch") and ctx.colorScheme and ctx.colorScheme.source
        and ctx.colorScheme.name and ctx.colorScheme.name ~= "" then
        noctalia.runAsync("noctalia msg color-scheme-set " .. ctx.colorScheme.source .. " " .. shellQuote(ctx.colorScheme.name))
    end
end

local function launchContext(ctx)
    for _, m in ipairs(ctx.members or {}) do
        if m.launch and m.launch ~= "" then
            dispatchExec(m.launch, m.workspace)
        end
    end
    applyContextVisuals(ctx)

    local data = loadData()
    data.activeContext = ctx.id
    noctalia.writeFile(DATA_PATH, noctalia.json.encode(data))
    noctalia.state.set("cw.data", data)
    noctalia.notify("Contextual Workspaces", "Launched: " .. ctx.name)
end

local function launchById(id)
    local data = loadData()
    local ctx = findContextById(data, id)
    if ctx then
        launchContext(ctx)
    end
end

-- Live workspace-navigation awareness: switch wallpaper/theme to whichever context owns
-- the workspace you just switched to, even when you got there manually (SUPER+N), not
-- through this plugin's launch action.
local lastLiveContextId = nil

local function findContextOwningWorkspace(data, wsId)
    for _, ctx in ipairs(data.contexts) do
        for _, m in ipairs(ctx.members or {}) do
            if m.workspace and tostring(m.workspace) == tostring(wsId) then
                return ctx
            end
        end
    end
    return nil
end

local function applyContextForWorkspace(wsId)
    if not noctalia.getConfig("auto-switch-on-workspace-change") then
        return
    end
    local data = loadData()
    local ctx = findContextOwningWorkspace(data, wsId)
    if not ctx or ctx.id == lastLiveContextId then
        return
    end
    lastLiveContextId = ctx.id
    applyContextVisuals(ctx)
end

local function startEventStream()
    if not noctalia.commandExists("socat") then
        return
    end
    local runtimeDir = noctalia.getenv("XDG_RUNTIME_DIR")
    local signature = noctalia.getenv("HYPRLAND_INSTANCE_SIGNATURE")
    if not runtimeDir or not signature then
        return
    end
    local socket = shellQuote(runtimeDir .. "/hypr/" .. signature .. "/.socket2.sock")
    noctalia.runStream("socat -u UNIX-CONNECT:" .. socket .. " -", function(line)
        local event, payload = string.match(line, "^([%a%d_]+)>>(.*)$")
        if event == "workspace" or event == "workspacev2" then
            local wsId = payload and (payload:match("^(%d+)") or payload:match(",(%d+)$"))
            if wsId then
                applyContextForWorkspace(wsId)
            end
        end
    end)
end

-- Opt-in nudge from the `thepunkoff/pomodoro` plugin: on a work/break transition it
-- broadcasts { isRunning, stage } (stage 1 = work, 2 = break). Off by default and a
-- no-op until both this setting and a target context are configured.
local function handlePomodoroState(payload)
    if noctalia.getConfig("enable-pomodoro-integration") ~= true then
        return
    end
    local ok, decoded = pcall(noctalia.json.decode, payload)
    if not ok or type(decoded) ~= "table" then
        return
    end

    local contextId
    if decoded.stage == 1 then
        contextId = noctalia.getConfig("pomodoro-focus-context-id")
    elseif decoded.stage == 2 then
        contextId = noctalia.getConfig("pomodoro-break-context-id")
    end
    if not contextId or contextId == "" then
        return
    end

    local data = loadData()
    local ctx = findContextById(data, contextId)
    if ctx then
        applyContextVisuals(ctx)
    end
end

--- main
noctalia.state.set("cw.data", loadData())
startEventStream()

noctalia.state.watch("cw.command", function(command)
    if not command or not command.action then
        return
    end
    if command.action == "save" then
        saveData(command.data)
    elseif command.action == "launch" then
        launchById(command.id)
    end
end)

function onIpc(event, payload)
    if event == "launch" then
        launchById(payload)
    elseif event == "pomodoro-state" then
        handlePomodoroState(payload)
    end
end
